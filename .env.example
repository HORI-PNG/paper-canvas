# ===== Supabase =====
# Supabase ダッシュボード > Project Settings > API Keys から取得
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# ブラウザに公開してよい鍵（sb_publishable_...）
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# サーバー専用の秘密鍵（sb_secret_...）。絶対に NEXT_PUBLIC_ を付けないこと
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# ===== Gemini =====
# https://aistudio.google.com/apikey から取得
GEMINI_API_KEY=xxxxxxxx
# 使うモデル（省略時は gemini-3.7-flash）
# GEMINI_MODEL=gemini-3.7-flash

# ===== その他（任意） =====
# 1ユーザーあたり24時間の AI 解析回数の上限（既定: 30）
# ANALYSIS_DAILY_LIMIT=30
# 本番の URL（OGP 画像などの絶対 URL に使う）
# NEXT_PUBLIC_SITE_URL=https://paper-canvas.vercel.app
# プライバシーポリシーに表示する連絡先
# NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
